MOMENCE_ACCESS_TOKEN=
MOMENCE_ALL_COOKIES=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Required: use a different Google Sheet from the old automation.
LC7_LIFECYCLE_SHEET_ID=

# Mailtrap API for member notification emails
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_API_TOKEN=
MAIL_FROM=hello@physique57india.com
MAIL_FROM_NAME=Mailtrap Test
MAIL_REPLY_TO=latecancellations@physique57india.com

# Optional safety controls
TEST_MEMBER_ID=
DRY_RUN=false
CRON_SCHEDULE=*/5 * * * *

# ---------------------------------------------------------------------------
# Location settings — one deployment (Railway service) per city/location.
# Leave blank to use the original defaults shown in comments.
# ---------------------------------------------------------------------------
LOCATION_NAME=
# Momence host/studio ID (default 13752)
MOMENCE_HOST_ID=
# Momence tag IDs for this host (defaults 164561 / 164581)
LC7_TAG_ID=
P57_TAG_ID=
# Currency used when refunding cancelled bookings (default inr)
MOMENCE_CURRENCY=
# Mailtrap stored templates + signature (defaults: current P57 templates)
MAILTRAP_TEMPLATE_A_UUID=
MAILTRAP_TEMPLATE_B_UUID=
MAIL_SIGNATURE_NAME=

# Optional tuning
REPORT_LOOKBACK_DAYS=30
REPORT_POLL_ATTEMPTS=40
REPORT_POLL_INTERVAL_MS=3000
MOMENCE_RATE_LIMIT_MS=200
MAX_AUTO_RETRIES=5
SHUTDOWN_TIMEOUT_MS=300000
